# ---------------------------------------------------------------------------
# Gemini-Game — Umgebungsvariablen & Konfiguration
# ---------------------------------------------------------------------------

# Port für Express & WebSockets (wird bei Render/Railway/Fly.io automatisch gesetzt)
PORT=3000

# Node-Umgebung (development oder production)
NODE_ENV=production

# Datenbank-Konfiguration:
# Für Produktion (Render PostgreSQL, Supabase, Neon, Railway etc.):
# DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"
# Wenn DATABASE_URL nicht gesetzt ist, nutzt der Server automatisch die lokale SQLite-Datenbank.
DATABASE_URL=

# Pfad zur lokalen SQLite-Datenbank (Standard: data/game.sqlite)
SQLITE_DB_PATH=data/game.sqlite

# SSL-Zertifikatsvalidierung für PostgreSQL (bei manchen Cloud-Providern 'false' erforderlich)
DB_SSL_REJECT_UNAUTHORIZED=false

# Authentifizierung & Sitzungs-Sicherheit
AUTH_COOKIE_NAME=gemini_game_session
AUTH_SESSION_TTL_MS=2592000000
AUTH_SECURE_COOKIE=true

# Erlaubte Origins für CORS & WebSocket (durch Kommas getrennt, z.B. https://mein-game.render.com)
# Leer lassen für reinen Same-Origin-Betrieb
ALLOWED_ORIGINS=

# Optional: Disable Vite HMR in container environments
DISABLE_HMR=false

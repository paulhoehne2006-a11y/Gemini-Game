# ---------------------------------------------------------------------------
# Gemini-Game — Umgebungsvariablen & Konfiguration
# ---------------------------------------------------------------------------

# Port für Express & WebSockets (wird bei Render automatisch gesetzt)
PORT=3000

# Node-Umgebung (development oder production)
NODE_ENV=production

# ---------------------------------------------------------------------------
# Neon PostgreSQL Datenbank (Serverless Postgres)
# ---------------------------------------------------------------------------
# Deine Neon-Verbindungs-URL (aus dem Neon-Projekt "Neu-Anspach Game", Region eu-central-1):
DATABASE_URL="postgresql://neondb_owner:npg_fPc9IN1qySAs@ep-bitter-mode-b9yvldty-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Pfad zur lokalen SQLite-Datenbank (wird genutzt, falls DATABASE_URL leer bleibt)
SQLITE_DB_PATH=data/game.sqlite

# SSL-Zertifikatsvalidierung für PostgreSQL
DB_SSL_REJECT_UNAUTHORIZED=false

# ---------------------------------------------------------------------------
# Authentifizierung & Sitzungs-Sicherheit
# ---------------------------------------------------------------------------
AUTH_COOKIE_NAME=gemini_game_session
AUTH_SESSION_TTL_MS=2592000000
AUTH_SECURE_COOKIE=true

# Erlaubte Origins für CORS & WebSocket (Render-URL deines Spiels)
ALLOWED_ORIGINS=https://neu-anspach.onrender.com

# ---------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect ("Anmelden mit Google")
# ---------------------------------------------------------------------------
# Trage hier deine Client-ID und dein Secret aus der Google Cloud Console ein:
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://neu-anspach.onrender.com/api/auth/google/callback

# ---------------------------------------------------------------------------
# Rechtliches & Impressum (§ 5 DDG & DSGVO)
# ---------------------------------------------------------------------------
VITE_LEGAL_OPERATOR_NAME="Paul Höhne (Privates, nicht-kommerzielles Hobbyprojekt)"
VITE_LEGAL_OPERATOR_ADDRESS="Häuser Weg 9, 61267 Neu-Anspach, Deutschland"
VITE_LEGAL_CONTACT_EMAIL="paulhoehne411@gmail.com"

DISABLE_HMR=false
